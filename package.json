{
  "name": "ai-interview-studio",
  "version": "0.1.0",
  "description": "개인용 Windows AI 모의 면접 데스크톱 앱 — MVP 0",
  "private": true,
  "license": "UNLICENSED",
  "author": "silverThunder09",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:review",
    "test:review": "node scripts/review/policy.test.mjs",
    "licenses": "node scripts/licenses.mjs",
    "package:win": "npm run build && npm run licenses && electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": { "global-agent": "4.1.3" },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "com.silverthunder09.aiinterviewstudio",
    "productName": "AI Interview Studio",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "release-notices",
        "to": "notices"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "artifactName": "AI-Interview-Studio-${version}-win-${arch}.${ext}"
  }
}
